{
	"name": "install-dprint",
	"version": "2.0.0",
	"private": true,
	"description": "GitHub Action to install the dprint code formatter with caching",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"autofix": "run --keep-going --sequential dprint:cfg:update dprint:autofix pkgMgr",
		"bd": "run build",
		"build": "tsdown",
		"dprint:autofix": "dprint fmt --allow-no-files --diff --excludes .github",
		"dprint:cfg:update": "if [[ \"${GITHUB_REF_NAME:-}\" = 'master' ]]; then dprint config update -yr; fi",
		"lint": "biome check",
		"pkgMgr": "bun pm pkg set packageManager=\"bun@$(bun --version)\"",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@actions/cache": "^6",
		"@actions/core": "^3",
		"@actions/exec": "^3",
		"@actions/glob": "^0.7",
		"@actions/http-client": "^4",
		"@actions/io": "^3",
		"@actions/tool-cache": "^4",
		"@types/bun": "^1.3",
		"@types/node": "^24",
		"biome": "npm:@biomejs/biome@2.5.4",
		"runner-run": "^0.20",
		"tsdown": "^0.22.12",
		"typescript": "^7"
	},
	"packageManager": "bun@1.4.0",
	"engines": {
		"node": "24"
	},
	"volta": {
		"node": "24.18.0",
		"npm": "11.18.0"
	}
}
